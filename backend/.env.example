# Application Configuration
APP_ENV=development
APP_PORT=8000

# Rate Limiter Settings
RATE_LIMIT_STORAGE=memory  # Options: memory, redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT_SECONDS=1.0
RATE_LIMIT_FAIL_OPEN=true   # If Redis fails, allow requests instead of 500 error

# Default Limits
DEFAULT_ANONYMOUS_LIMIT=10
DEFAULT_ANONYMOUS_WINDOW_SECONDS=60
